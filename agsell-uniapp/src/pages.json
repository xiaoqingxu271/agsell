{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "type": "home",
      "style": { "enablePullDownRefresh": true, "backgroundTextStyle": "dark" }
    },
    { "path": "pages/category/category", "type": "page" },
    { "path": "pages/product/product", "type": "page", "style": { "navigationStyle": "custom" } },
    {
      "path": "pages/cart/cart",
      "type": "page",
      "style": { "enablePullDownRefresh": true, "backgroundTextStyle": "dark" }
    },
    { "path": "pages/order/list/list", "type": "page" },
    { "path": "pages/order/detail/detail", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/order/confirm/confirm", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/order/pay/pay", "type": "page" },
    { "path": "pages/order/pay-success/pay-success", "type": "page" },
    { "path": "pages/review/write/write", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/review/list/list", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/after-sales/apply/apply", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/after-sales/detail/detail", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/after-sales/list/list", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/trace/detail", "type": "page", "style": { "navigationStyle": "custom" } },
    {
      "path": "pages/seckill/list",
      "type": "page",
      "style": { "navigationStyle": "custom", "enablePullDownRefresh": true, "backgroundTextStyle": "light" }
    },
    { "path": "pages/seckill/detail", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/coupon/center", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/coupon/my", "type": "page", "style": { "navigationStyle": "custom" } },
    {
      "path": "pages/mine/mine",
      "type": "page",
      "style": { "enablePullDownRefresh": true, "backgroundTextStyle": "dark" }
    },
    { "path": "pages/mine/address", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine/settings", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine/profile", "type": "page", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine/about", "type": "page", "style": { "navigationStyle": "custom" } },
    {
      "path": "pages/mine/message",
      "type": "page",
      "style": { "navigationStyle": "custom", "enablePullDownRefresh": true, "backgroundTextStyle": "dark" }
    },
    {
      "path": "pages/mine/favorite",
      "type": "page",
      "style": { "navigationStyle": "custom", "enablePullDownRefresh": true, "backgroundTextStyle": "dark" }
    },
    { "path": "pages/ai-chat/chat", "type": "page", "style": { "navigationStyle": "custom" } },
    {
      "path": "pages/search/search",
      "type": "page",
      "style": { "navigationBarTitleText": "搜索", "enablePullDownRefresh": true, "backgroundTextStyle": "dark" }
    }
  ],
  "globalStyle": {
    "navigationBarBackgroundColor": "#FFFFFF",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "农产品商城",
    "backgroundColor": "#F4F5F7",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#9AA0A8",
    "selectedColor": "#E1251B",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tab-home.png",
        "selectedIconPath": "static/tab-home-active.png"
      },
      {
        "pagePath": "pages/category/category",
        "text": "分类",
        "iconPath": "static/tab-category.png",
        "selectedIconPath": "static/tab-category-active.png"
      },
      {
        "pagePath": "pages/cart/cart",
        "text": "购物车",
        "iconPath": "static/tab-cart.png",
        "selectedIconPath": "static/tab-cart-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "static/tab-mine.png",
        "selectedIconPath": "static/tab-mine-active.png"
      }
    ]
  },
  "uniIdHooks": true,
  "networkTimeout": {
    "request": 10000,
    "connectSocket": 10000,
    "downloadFile": 10000
  }
}
