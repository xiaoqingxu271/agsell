# ============================================================
# docker compose 使用的环境变量模板
#   cp .env.example .env  然后把占位值换成真实值（.env 已被 gitignore，禁止提交）
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me

# ---- JWT 签名密钥（HS256 需 >=64 字节，生成：openssl rand -base64 64）----
JWT_SECRET=change-me-64-bytes-minimum

# ---- 微信小程序（微信公众平台 → 开发管理 → AppID 与 AppSecret）----
WECHAT_MINIAPP_APPID=wx0000000000000000
WECHAT_MINIAPP_SECRET=change-me

# ---- 阿里云 OSS（图片/素材存储）----
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=change-me
ALIYUN_OSS_ACCESS_KEY_SECRET=change-me
ALIYUN_OSS_BUCKET_NAME=change-me

# ---- AI 服务间密钥 ----
# Python 回调 Java /api/ai/internal/** 时携带的 X-Internal-Key，
# 必须与 ai-service/.env 的 JAVA_INTERNAL_KEY 完全一致。
# application.yaml 已取消默认值：本项缺失时 backend 启动即失败，不会静默使用公开密钥。
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AI_INTERNAL_KEY=change-me-shared-with-ai-service
