# Agnes AI 免费大模型（模板：复制为 .env 后填写自己的 Key）
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_TEMPERATURE=0.3

# Java 主系统服务间鉴权（与 agsell application.yaml 的 ai-service.internal-key 一致）
JAVA_INTERNAL_KEY=agsell-ai-internal-2026
JAVA_BASE_URL=http://127.0.0.1:8080/api

# MySQL（复用 agsell 主库）
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/agsell?charset=utf8mb4

# FAQ 知识库（RAG）
PLATFORM_NAME=农产品销售系统
SERVICE_PHONE=400-000-0000
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_DB_PATH=data/
KB_TOP_K=5

# 模型下载加速（HuggingFace 国内镜像）
HF_ENDPOINT=https://hf-mirror.com

# 阶段五：会话记忆后端
#   sqlite = 本地文件持久化（默认，跨重启恢复，零外部依赖）
#   memory = 进程内（重启丢失，仅调试）
#   redis  = RedisSaver（需 Redis 8+ 内置 RediSearch；docker-compose 内置 redis-stack）
MEMORY_BACKEND=sqlite
REDIS_URL=redis://127.0.0.1:6379/0
SQLITE_PATH=data/checkpoints.db

# 阶段五：Agnes 调用重试与超时
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# 运行时
LOG_LEVEL=INFO
