# ============================================================
# 本地开发配置模板
# 使用方法：复制本文件为同目录下的 application-local.yaml，填入你自己的密钥。
# application-local.yaml 已被 .gitignore 忽略，永远不会提交进仓库。
# ============================================================

server:
  port: 8080
  servlet:
    context-path: /api

spring:
  application:
    name: agsell
  datasource:
    url: jdbc:mysql://localhost:3306/agsell?useSSL=false&serverTimezone=UTC
    driver-class-name: com.mysql.cj.jdbc.Driver
    password: 你的数据库密码
    username: root
  data:
    redis:
      host: localhost
      port: 6379
      password:
      database: 0
      timeout: 60s

# JWT：HS512 要求密钥 >= 64 字节，可用 openssl rand -base64 64 生成
jwt:
  expiration: 86400000 # 过期时间，单位毫秒
  secret: 换成你自己的64字节以上随机字符串
  token-header: Authorization
  token-prefix: Bearer

# 微信小程序配置（微信公众平台 → 开发管理 → 开发设置）
wechat:
  miniapp:
    appid: 你的小程序AppID
    secret: 你的小程序AppSecret
    code2session_url: https://api.weixin.qq.com/sns/jscode2session

# 阿里云 OSS 配置（建议使用 RAM 子账号，仅授予目标 bucket 权限）
aliyun:
  oss:
    endpoint: oss-cn-beijing.aliyuncs.com
    access-key-id: 你的AccessKeyId
    access-key-secret: 你的AccessKeySecret
    bucket-name: 你的bucket名
    url-prefix: ""
    max-file-size: 10
    image-max-file-size: 5
    allowed-image-types: jpg,jpeg,png,gif,webp,bmp
    allowed-video-types: mp4,avi,mov,wmv
    allowed-other-types: pdf,doc,docx,xls,xlsx,ppt,pptx,zip,txt

# 溯源配置
trace:
  base-url: http://localhost:8080/api # 溯源 H5 页面域名（二维码内容前缀），部署时改为线上域名

# AI 客服服务配置
ai-service:
  base-url: http://127.0.0.1:8000 # Python AI 服务地址
  internal-key: 换成与ai-service/.env一致的内部密钥
